# Enable Banking (session ID is per bank; app credentials are shared, see eb-config.json)
ENABLE_BANKING_SESSION_ID_ING=enc:placeholder
ENABLE_BANKING_SESSION_ID_REVOLUT=enc:placeholder
ENABLE_BANKING_SESSION_ID_MYINVESTOR=enc:placeholder
ENABLE_BANKING_SESSION_ID_SABADELL=enc:placeholder
ENABLE_BANKING_APP_ID=enc:placeholder

# Google Sheets
GOOGLE_SHEETS_CREDENTIALS=enc:placeholder
GOOGLE_SHEET_ID=enc:placeholder

# Gmail SMTP
GMAIL_SMTP_PASSWORD=enc:placeholder
GMAIL_FROM=enc:placeholder
GMAIL_TO=enc:placeholder

# Non-sensitive
LOG_LEVEL=INFO
